# ── Server ──
PORT=3001

# ── NestJS Backend API ──
BACKEND_API_URL=http://localhost:8080

# ── Internal Microservice API Key ──
SERVICE_API_KEY=your-secure-internal-api-key

# ── Google Gemini AI ──
GOOGLE_API_KEY=your-key-here

# ── LangSmith Observability (optional) ──
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=ls__your_key_here
LANGCHAIN_PROJECT="realvista-ai"

# ── Qdrant Vector Database ──
# When using Docker Compose, this is overridden to http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=realestate_knowledge

# ── User Behavior Vector Collection ──
# Separate Qdrant collection for storing user behavior vectors
QDRANT_BEHAVIOR_COLLECTION=user_behavior
